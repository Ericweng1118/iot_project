# ============================================================
# 複製成 .env 後填入實際值：cp env.example .env
# .env 已列入 .gitignore，請勿提交。
# ============================================================

# ===== 資料庫連線設定 =====
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=industrial_db
DB_USER=postgres
DB_PASSWORD=your_secure_password

# ===== MQTT 伺服器設定 =====
# MQTT_ENABLED=false 時完全不建立 MQTT 連線、不發送任何訊息
MQTT_ENABLED=true
MQTT_BROKER=127.0.0.1
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
MQTT_GROUP_ID=scada_unified
MQTT_TOPIC=iot-2/evt/wadata/fmt/scada_unified
# 心跳全量發送週期（秒）：平常只發送有變化的點位，但每隔這段時間會強制
# 全量送一次，讓下游確認每個點位都還活著。預設 300 秒。
MQTT_FORCE_FULL_INTERVAL=300

# ===== 協議啟用開關 =====
# 設為 false 完全屏蔽該協議：
#   - main.py 不會匯入、也不會啟動該協議的採集執行緒
#   - admin_app.py 網頁後台會完全隱藏該協議對應的分頁（不是灰掉，是分頁不存在）
# 預設值皆為 true（相容既有部署），要屏蔽的話設為 false 即可，不需要改程式碼。
MODBUS_ENABLED=false
TIA_ENABLED=false
OPCUA_ENABLED=true

# ===== 採集服務週期設定 =====
# 僅套用於 Modbus / TIA(S7)；OPC UA 走常駐訂閱服務，不受此週期影響
POLL_INTERVAL=60.0

# ===== sensor_readings 統一寫入排程 =====
# 全部感測器一起檢查、統一批次寫入的固定週期（秒）。
# 個別感測器這一輪實際要不要寫，依 sensors.upload_condition /
# sensors.upload_threshold 判斷（見 sql/006_opcua_upgrade.sql）。
# 不建議設太短（例如 <5 秒），判斷與寫入都是整批處理，週期太短只會增加 DB 負擔。
SENSOR_READING_FLUSH_INTERVAL=60

# 心跳保底（秒）：距離上次實際寫入超過這個時間，不管 upload_condition 判斷結果
# 如何都強制補寫一筆。設 0 代表關閉。
# ⚠️ 不建議關閉：沒有心跳的話，門檻設得不合理的點位會完全沒有任何紀錄，而且
#    不會有錯誤訊息 —— 2026-09-03 ~ 09-11 就發生過 47 個累計型感測器因為套用
#    預設 1% 的 threshold_percent 而集體無聲停止寫入（詳見 todo.md 待辦 #2）。
#    心跳補寫讓「設備沒有新資料」跟「採集系統掛了」在資料上可以區分開來。
SENSOR_HEARTBEAT_INTERVAL=3600

# ===== OPC UA 訂閱設定 =====
# 全域預設訂閱取樣頻率（毫秒）。實際生效值的優先序（由高到低）：
#   1. sensors.opcua_sampling_interval_ms   逐感測器（最優先）
#   2. opcua_servers.publish_interval_ms    逐 Server（網頁可編輯，見 sql/009）
#   3. 本變數                                全域預設（前兩者皆為 NULL 時採用）
OPCUA_PUBLISH_INTERVAL_MS=1000

# ===== OPC UA 連線穩定性參數（網路品質不穩的場域可調高）=====
OPCUA_CLIENT_TIMEOUT=10           # 單次請求逾時秒數
OPCUA_HEARTBEAT_INTERVAL_SEC=15   # 心跳檢查週期
OPCUA_HEARTBEAT_TIMEOUT_SEC=8     # 單次心跳讀取逾時秒數
OPCUA_HEARTBEAT_MAX_FAILURES=2    # 連續失敗幾次才判定斷線、觸發完整重連

# ===== 網頁管理後台（admin_app.py）=====
ADMIN_USER=user
ADMIN_PASSWORD=change_me
ADMIN_PORT=8501
