# ============================================================
# 複製成 .env 後填入實際值：cp env.example .env
# .env 已列入 .gitignore，請勿提交。
# ============================================================

# ===== 資料庫連線設定 =====
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=industrial_db
DB_USER=postgres
DB_PASSWORD=your_secure_password

# ===== MQTT 伺服器設定 =====
# MQTT_ENABLED=false 時完全不建立 MQTT 連線、不發送任何訊息
MQTT_ENABLED=true
MQTT_BROKER=127.0.0.1
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
MQTT_GROUP_ID=scada_unified
MQTT_TOPIC=iot-2/evt/wadata/fmt/scada_unified
# 心跳全量發送週期（秒）：平常只發送有變化的點位，但每隔這段時間會強制
# 全量送一次，讓下游確認每個點位都還活著。預設 300 秒。
MQTT_FORCE_FULL_INTERVAL=300
# 🆕 是否一併上傳 OPC UA 已綁定感測器的點位（Key = sensor_code、只送品質 GOOD 的值）。
# 預設 false 維持既有下游資料格式；純 OPC UA 部署要用 MQTT 時請設為 true。
MQTT_INCLUDE_OPCUA=false

# ===== 協議啟用開關 =====
# 設為 false 完全屏蔽該協議：
#   - main.py 不會匯入、也不會啟動該協議的採集執行緒
#   - admin_app.py 網頁後台會完全隱藏該協議對應的分頁（不是灰掉，是分頁不存在）
# 預設值皆為 true（相容既有部署），要屏蔽的話設為 false 即可，不需要改程式碼。
MODBUS_ENABLED=false
TIA_ENABLED=false
OPCUA_ENABLED=true

# ===== 採集服務週期設定 =====
# 僅套用於 Modbus / TIA(S7)；OPC UA 走常駐訂閱服務，不受此週期影響
POLL_INTERVAL=60.0

# ===== 🆕 v3.1 Modbus 採集參數 =====
MODBUS_TIMEOUT=3                  # 單次請求逾時（秒）
MODBUS_RETRIES=1                  # 逾時重試次數（離線設備越多次，整輪越慢）
MODBUS_MAX_BLOCK_REGISTERS=100    # 一次讀取的暫存器上限（部分設備只接受 32 / 64，可調小）
MODBUS_MAX_GAP=10                 # 兩個點位相隔幾個暫存器以內才合併成一次讀取
MODBUS_MAX_WORKERS=8              # 同時採集的實體連線數上限
# 網頁「Modbus 線上調適」的寫入測試（FC05/06/16）。會直接改變現場設備，預設關閉
MODBUS_DEBUG_WRITE_ENABLED=false

# ===== 🆕 v3.3 Siemens S7 採集參數 =====
S7_MAX_GAP=32                     # 同一個 DB 裡兩個點位相隔幾個 byte 以內才合併成一次讀取
S7_MAX_BLOCK=400                  # 一次讀取的 byte 上限
S7_MAX_WORKERS=8                  # 同時採集的 PLC 數上限
# 網頁「S7 線上調適」的寫入測試。會直接改變 PLC 變數，預設關閉
S7_DEBUG_WRITE_ENABLED=false

# ===== sensor_readings 統一寫入排程 =====
# 全部感測器一起檢查、統一批次寫入的固定週期（秒）。
# 個別感測器這一輪實際要不要寫，依 sensors.upload_condition /
# sensors.upload_threshold 判斷（見 sql/006_opcua_upgrade.sql）。
# 不建議設太短（例如 <5 秒），判斷與寫入都是整批處理，週期太短只會增加 DB 負擔。
SENSOR_READING_FLUSH_INTERVAL=60

# 心跳保底（秒）：距離上次實際寫入超過這個時間，不管 upload_condition 判斷結果
# 如何都強制補寫一筆。設 0 代表關閉。
# ⚠️ 不建議關閉：沒有心跳的話，門檻設得不合理的點位會完全沒有任何紀錄，而且
#    不會有錯誤訊息 —— 2026-09-03 ~ 09-11 就發生過 47 個累計型感測器因為套用
#    預設 1% 的 threshold_percent 而集體無聲停止寫入（詳見 todo.md 待辦 #2）。
#    心跳補寫讓「設備沒有新資料」跟「採集系統掛了」在資料上可以區分開來。
SENSOR_HEARTBEAT_INTERVAL=3600

# 🆕 v3：資料來源「存活」判定窗口（秒）。心跳補寫與 always 條件在「數值沒變」時會以
# 目前時間補寫一筆，前提是來源在這段時間內確認過還活著（Modbus/TIA 輪詢成功、
# OPC UA 連線心跳成功）。斷線時不補寫，避免用舊值掩蓋斷線。
# Modbus/TIA 的 POLL_INTERVAL 若大於這個值，請一併調大。
SENSOR_ALIVE_WINDOW=300

# 🆕 v3.1：本機緩存（Store-and-Forward）。資料庫寫不進去時先存在本機 SQLite，恢復後自動補寫。
# Docker 部署請把這個目錄掛 volume（-v /opt/scada/data:/app/data），否則重建容器時緩存會消失。
SPOOL_DIR=data
SPOOL_MAX_ROWS=2000000            # 上限（約 100 MB），超過丟棄最舊的資料

# ===== OPC UA 訂閱設定 =====
# 全域預設訂閱取樣頻率（毫秒）。實際生效值的優先序（由高到低）：
#   1. sensors.opcua_sampling_interval_ms   逐感測器（最優先）
#   2. opcua_servers.publish_interval_ms    逐 Server（網頁可編輯，見 sql/009）
#   3. 本變數                                全域預設（前兩者皆為 NULL 時採用）
OPCUA_PUBLISH_INTERVAL_MS=1000

# ===== OPC UA 連線穩定性參數（網路品質不穩的場域可調高）=====
OPCUA_CLIENT_TIMEOUT=10           # 單次請求逾時秒數
OPCUA_HEARTBEAT_INTERVAL_SEC=15   # 心跳檢查週期
OPCUA_HEARTBEAT_TIMEOUT_SEC=8     # 單次心跳讀取逾時秒數
OPCUA_HEARTBEAT_MAX_FAILURES=2    # 連續失敗幾次才判定斷線、觸發完整重連

# ===== 🆕 警報引擎（需先執行 sql/011_alarm_management.sql）=====
ALARM_ENABLED=true
ALARM_EVAL_INTERVAL=5             # 判斷週期（秒），直接讀記憶體最新值，不必等寫入週期
ALARM_RULE_REFRESH_INTERVAL=15    # 網頁改了警報規則後，最慢幾秒套用
# sensors.min_threshold / max_threshold 自動視為 L / H 警報（等級「中」）
ALARM_USE_SENSOR_LIMITS=true
ALARM_LIMIT_PRIORITY=3            # 上下限警報的等級：1=緊急 2=高 3=中 4=低
ALARM_COMM_PRIORITY=2             # 通訊中斷（OPC UA Server / PLC 斷線）警報的等級
ALARM_COMM_DELAY_SEC=60           # 斷線持續多久才發通訊中斷警報（濾掉短暫重連）

# ===== 🆕 警報通知（都不設定 = 只在網頁顯示）=====
ALARM_NOTIFY_MIN_PRIORITY=3       # 只通知等級 <= 此值的警報（3 = 緊急/高/中）
ALARM_NOTIFY_ON_CLEAR=true        # 警報恢復時也通知
SCADA_SITE_NAME=IIoT SCADA        # 通知標題前綴，多廠區時用來分辨
# Webhook（逗號分隔可多個）：POST JSON {"event","text","content","alarm"}，
# n8n / Slack / Mattermost / Discord 可直接接
ALARM_WEBHOOK_URLS=
# Email（Port 465 自動使用 SSL；其他 Port 依 SMTP_STARTTLS 決定）
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
ALARM_EMAIL_FROM=
ALARM_EMAIL_TO=
# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===== 🆕 v3.2 計算點 / 排程報表 =====
CALC_ENABLED=true                 # 計算點引擎（需要 sql/017）
CALC_INTERVAL=5                   # 計算週期（秒）
# 🆕 v3.4 Python 腳本計算點（需要 sql/021）。腳本在獨立子程序執行（逾時 / 記憶體上限），
# 只有「管理員」能新增 / 修改。⚠️ 不是安全沙箱，請只放可信任的程式碼。預設關閉
CALC_SCRIPTS_ENABLED=false
CALC_SCRIPT_TIMEOUT=2             # 每個腳本每輪最多執行幾秒，超時強制終止（之後退避 30 秒 ~ 10 分鐘再試）
CALC_SCRIPT_MEMORY_MB=512         # 腳本子程序的記憶體上限
REPORT_SCHEDULER_ENABLED=true     # 排程報表（需要 sql/018），寄送沿用上方的 SMTP / Webhook 設定

# ===== 🆕 系統 =====
# 網頁顯示 / 日期選擇 / 報表匯出用的時區（容器沒設 TZ 時系統時區是 UTC，不能依賴它）
SCADA_TIMEZONE=Asia/Taipei
STATUS_REPORT_INTERVAL=10         # main.py 寫入 service_status 心跳的週期（秒）
DB_POOL_MAX=20                    # 每個程序的 DB 連線池上限

# ===== 網頁管理後台（admin_app.py）=====
# v3 起可在網頁「使用者管理」建立多個帳號與角色（需先執行 sql/012）。
# 這組 .env 帳密永遠可以用「管理員」身分登入，當作救援帳號，務必改掉預設值。
ADMIN_USER=user
ADMIN_PASSWORD=change_me
ADMIN_PORT=8501
# 🆕 v3.1 HTTPS：設定憑證後網頁改走 https（scripts/gen_self_signed_cert.sh 可產生自簽憑證）
ADMIN_SSL_CERT=
ADMIN_SSL_KEY=
# 🆕 v3.1 閒置自動登出（分鐘，0 = 關閉）；列出的角色不受限（控制室監看螢幕用檢視者帳號登入）
ADMIN_IDLE_TIMEOUT_MIN=30
ADMIN_IDLE_TIMEOUT_EXEMPT_ROLES=viewer
