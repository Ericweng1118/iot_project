# ===== 資料庫連線設定 =====
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=industrial_db
DB_USER=postgres
DB_PASSWORD=your_secure_password

# ===== MQTT 伺服器設定 =====
MQTT_ENABLED=true
MQTT_BROKER=127.0.0.1
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
MQTT_GROUP_ID=scada_unified
MQTT_TOPIC=iot-2/evt/wadata/fmt/scada_unified

# ===== 協議啟用開關 (🆕 新增) =====
# 這次升級聚焦強化 OPC UA，Modbus / TIA(S7) 可透過以下開關完全屏蔽：
#   - main.py 不會啟動該協議的採集執行緒
#   - admin_app.py 網頁後台會完全隱藏該協議對應的分頁（含新增/編輯功能）
# 預設值皆為 true（相容既有部署行為），要屏蔽的話設為 false 即可，不需要改程式碼。
MODBUS_ENABLED=false
TIA_ENABLED=false
OPCUA_ENABLED=true

# ===== 採集服務週期設定 =====
# 僅套用於 Modbus / TIA(S7)；OPC UA 已改為常駐訂閱服務，不受此週期影響
POLL_INTERVAL="60.0"

# OPC UA 查詢瀏覽週期（僅供獨立測試腳本 collector/run_opcua_collector.py 使用，
# main.py 平時走常駐訂閱服務，不受此參數影響）
OPCUA_POLL_INTERVAL="60.0"

# OPC UA Server 層級的預設訂閱取樣頻率（毫秒）。
# 個別感測器可在 sensors.opcua_sampling_interval_ms 覆寫，覆寫值優先。
OPCUA_PUBLISH_INTERVAL_MS=1000

# ===== sensor_readings 統一寫入排程設定 (🆕 重新設計) =====
# 不再單純依「數值變化 / 心跳」逐點位分散決定是否寫入，
# 改成固定週期（秒），全部感測器一起檢查、統一批次寫入 sensor_readings。
# 每個感測器「這一輪實際要不要寫」則依 sensors.upload_condition /
# sensors.upload_threshold 判斷（always / on_change / threshold，見 sql/006_opcua_upgrade.sql）。
SENSOR_READING_FLUSH_INTERVAL=60

# ===== 網頁小工具入口帳號、密碼、PORT =====
ADMIN_USER=user
ADMIN_PASSWORD=password
ADMIN_PORT=PORT_NUMBER
